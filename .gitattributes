# Let Git handle text/eol automatically; do not force-renormalize the existing tree.
* text=auto

# --- Native source: normalize to LF for clean cross-platform (Windows + Linux) builds ---
*.c      text eol=lf
*.cc     text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.hlsl   text eol=lf
*.hlsli  text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf

# --- Windows / MSVC project files: keep CRLF ---
*.sln            text eol=crlf
*.vcxproj        text eol=crlf
*.vcxproj.filters text eol=crlf
*.props          text eol=crlf
*.bat            text eol=crlf
*.cmd            text eol=crlf

# --- Binary assets ---
*.png    binary
*.jpg    binary
*.pdf    binary
*.npz    binary
*.tar.gz binary
*.nupkg  binary

# --- Model weights via Git LFS (scoped to the runtime models tree) ---
runtime/models/**/*.bin filter=lfs diff=lfs merge=lfs -text
