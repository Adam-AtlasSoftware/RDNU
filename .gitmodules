[submodule "runtime/external/DirectX-Headers"]
	path = runtime/external/DirectX-Headers
	url = https://github.com/microsoft/DirectX-Headers.git
[submodule "runtime/external/vcpkg"]
	path = runtime/external/vcpkg
	url = https://github.com/microsoft/vcpkg.git
[submodule "runtime/external/FidelityFX-SDK_WithFSR4"]
	path = runtime/external/FidelityFX-SDK_WithFSR4
	url = git@github.com:Adam-AtlasSoftware/FidelityFX-SDK_WithFSR4.git
	branch = rdnu
[submodule "ml/model-gym"]
	path = ml/model-gym
	url = https://github.com/arm/neural-graphics-model-gym.git
[submodule "ml/capture-unreal"]
	path = ml/capture-unreal
	url = https://github.com/arm/neural-graphics-data-capture-for-unreal.git
[submodule "ml/models/nss"]
	path = ml/models/nss
	url = https://huggingface.co/Arm/neural-super-sampling
[submodule "ml/models/nfru"]
	path = ml/models/nfru
	url = https://huggingface.co/Arm/neural-frame-rate-upscaling
	update = none
[submodule "ml/data/arm-neural-graphics-dataset"]
	path = ml/data/arm-neural-graphics-dataset
	url = https://huggingface.co/datasets/Arm/neural-graphics-dataset
	update = none
[submodule "ml/data/gameir"]
	path = ml/data/gameir
	url = https://huggingface.co/datasets/LLLebin/GameIR
	update = none
[submodule "ml/data/m3vir"]
	path = ml/data/m3vir
	url = https://huggingface.co/datasets/guluthemonster/M3VIR
	update = none
[submodule "runtime/external/neural-graphics-sdk-for-game-engines"]
	path = runtime/external/neural-graphics-sdk-for-game-engines
	url = https://github.com/arm/neural-graphics-sdk-for-game-engines.git
